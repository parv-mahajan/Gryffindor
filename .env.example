# Backend
DATABASE_URL=postgresql+psycopg://civicsense:civicsense@localhost:5432/civicsense
CIVICSENSE_CORS_ORIGINS=http://localhost:5173
CIVICSENSE_EMBED_MODEL=all-MiniLM-L6-v2
CIVICSENSE_MODEL_VERSION=minilm-l6-v2@2026-10

# Optional zero-shot image classification (off by default).
CIVICSENSE_CLIP_ENABLED=0
CIVICSENSE_CLIP_MODEL=openai/clip-vit-base-patch32
